<Page x:Class="SportProgramm.Pages.TournamentDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SportProgramm.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TournamentDetailsPage">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Информация о турнире -->
            <Border Grid.Row="0" Style="{StaticResource NewsSectionStyle}" Margin="0 0 0 20">
                <StackPanel>
                    <TextBlock Text="{Binding TournamentName}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TournamentPlace}" FontSize="14" Foreground="#7f8c8d" Margin="0 5 0 0"/>
                    <TextBlock Text="{Binding TournamentDate, StringFormat='dd.MM.yyyy'}" 
                               FontSize="12" Foreground="#95a5a6" Margin="0 5 0 0"/>
                    <TextBlock Text="{Binding SportName}" FontSize="12" Foreground="#3498db"/>
                </StackPanel>
            </Border>

            <!-- Результаты участников -->
            <TextBlock Grid.Row="1" Text="Результаты участников" 
                       FontSize="18" FontWeight="Bold" Foreground="#2c3e50"
                       Margin="0 0 0 15"/>

            <ItemsControl Grid.Row="2" x:Name="ResultsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource NewsSectionStyle}" Margin="0 10">
                            <Grid Margin="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Место -->
                                <TextBlock Grid.Column="0" Text="{Binding Position}" 
                                           FontSize="16" FontWeight="Bold" Foreground="#2c3e50"
                                           Width="30" VerticalAlignment="Center"/>

                                <!-- Спортсмен -->
                                <StackPanel Grid.Column="1" Margin="10 0">
                                    <TextBlock Text="{Binding PlayerName}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Team}" FontSize="11" Foreground="#7f8c8d"/>
                                </StackPanel>

                                <!-- Результат -->
                                <TextBlock Grid.Column="2" Text="{Binding Score}" 
                                           FontSize="13" FontWeight="Bold" Foreground="#e74c3c"
                                           VerticalAlignment="Center" Margin="0 0 15 0"/>

                                <!-- Очки -->
                                <TextBlock Grid.Column="3" Text="{Binding Points}" 
                                           FontSize="12" Foreground="#27ae60"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</Page>
