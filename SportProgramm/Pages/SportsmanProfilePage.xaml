<Page x:Class="SportProgramm.Pages.SportsmanProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:SportProgramm.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="SportsmanProfilePage">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Информация о спортсмене -->
            <Border Grid.Row="0" Style="{StaticResource NewsSectionStyle}" Margin="0 0 0 20">
                <StackPanel>
                    <TextBlock Text="{Binding PlayerName}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Team}" FontSize="14" Foreground="#7f8c8d" Margin="0 5 0 0"/>
                    <TextBlock Text="{Binding Level}" FontSize="12" Foreground="#3498db"/>
                    <TextBlock Text="Лучший результат: " FontSize="12" Margin="0 5 0 0">
                        <Run Text="{Binding BestResult}" FontWeight="Bold"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Турниры спортсмена -->
            <TextBlock Grid.Row="1" Text="Участие в турнирах" 
                       FontSize="18" FontWeight="Bold" Foreground="#2c3e50"
                       Margin="0 0 0 15"/>

            <ItemsControl Grid.Row="2" x:Name="TournamentsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource NewsSectionStyle}" Margin="0 10" Cursor="Hand"
                                MouseLeftButtonUp="TournamentItem_Click">
                            <Grid Margin="15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding TournamentName}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TournamentPlace}" FontSize="11" Foreground="#7f8c8d"/>
                                    <TextBlock Text="{Binding TournamentDate, StringFormat='dd.MM.yyyy'}" 
                                               FontSize="10" Foreground="#95a5a6"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding Position}" 
                                           FontSize="16" FontWeight="Bold" Foreground="#e74c3c"
                                           Margin="0 0 15 0" VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="2" Text="{Binding Score}" 
                                           FontSize="12" Foreground="#27ae60"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</Page>
