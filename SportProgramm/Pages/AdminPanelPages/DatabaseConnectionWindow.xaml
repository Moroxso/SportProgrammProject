<Window x:Class="SportProgramm.Pages.AdminPanelPages.DatabaseConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SportProgramm.Pages.AdminPanelPages"
        mc:Ignorable="d"
        Title="DatabaseConnectionWindow" Height="450" Width="800">
    <Border Style="{StaticResource AdminPanelStyle}" Margin="30">
        <StackPanel>
            <TextBlock Text="Настройка подключения" 
                       FontSize="20" FontWeight="Bold" Foreground="#2c3e50"
                       HorizontalAlignment="Center" Margin="0 0 0 20"/>

            <StackPanel Margin="0 20">
                <TextBlock Text="Тип подключения:" FontWeight="SemiBold" Margin="0 0 0 10"/>

                <RadioButton x:Name="SqlServerRadio" Content="SQL Server" GroupName="DbType" 
                           IsChecked="True" Checked="ConnectionType_Changed"/>
                <RadioButton x:Name="LocalDbRadio" Content="Локальная база данных" GroupName="DbType"
                           Checked="ConnectionType_Changed" Margin="0 5 0 0"/>

                <!-- Настройки SQL Server -->
                <StackPanel x:Name="SqlServerPanel" Margin="0 15 0 0">
                    <TextBlock Text="Сервер:" FontWeight="SemiBold" Margin="0 0 0 5"/>
                    <TextBox x:Name="ServerTextBox" Text="(local)" Height="30"/>

                    <TextBlock Text="База данных:" FontWeight="SemiBold" Margin="0 10 0 5"/>
                    <TextBox x:Name="DatabaseTextBox" Text="SportProgrammProject" Height="30"/>

                    <CheckBox x:Name="WindowsAuthCheckBox" Content="Аутентификация Windows" 
                             IsChecked="True" Checked="AuthType_Changed" Unchecked="AuthType_Changed"/>

                    <StackPanel x:Name="SqlAuthPanel" Visibility="Collapsed" Margin="0 10 0 0">
                        <TextBlock Text="Логин:" FontWeight="SemiBold" Margin="0 0 0 5"/>
                        <TextBox x:Name="UsernameTextBox" Height="30"/>

                        <TextBlock Text="Пароль:" FontWeight="SemiBold" Margin="0 10 0 5"/>
                        <PasswordBox x:Name="PasswordBox" Height="30"/>
                    </StackPanel>
                </StackPanel>

                <!-- Статус подключения -->
                <Border Background="#e8f5e8" BorderBrush="#27ae60" BorderThickness="1" 
                        CornerRadius="5" Padding="10" Margin="0 15 0 0">
                    <TextBlock x:Name="StatusText" Text="Готово к подключению" 
                              Foreground="#27ae60" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 20">
                <Button Content="Подключиться" Style="{StaticResource SuccessButtonStyle}"
                        Click="Connect_Click" Width="120"/>
                <Button Content="Отмена" Style="{StaticResource AdminButtonStyle}" 
                        Background="#95a5a6" Click="Cancel_Click" 
                        Width="120" Margin="15 0 0 0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
