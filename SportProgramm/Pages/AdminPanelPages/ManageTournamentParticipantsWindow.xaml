<Window x:Class="SportProgramm.Pages.AdminPanelPages.ManageTournamentParticipantsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SportProgramm.Pages.AdminPanelPages"
        mc:Ignorable="d"
        Title="ManageTournamentParticipantsWindow" Height="800" Width="900">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Информация о турнире -->
        <Border Grid.Row="0" Style="{StaticResource NewsSectionStyle}" Margin="0 0 0 15">
            <StackPanel>
                <TextBlock x:Name="TournamentTitle" FontSize="18" FontWeight="Bold"/>
                <TextBlock x:Name="TournamentInfo" FontSize="12" Foreground="#7f8c8d" Margin="0 5 0 0"/>
            </StackPanel>
        </Border>

        <!-- Доступные спортсмены -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Доступные спортсмены" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Поиск и фильтры -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBox x:Name="SearchTextBox" Width="200" Height="30" Padding="5"
                             TextChanged="SearchTextBox_TextChanged" />
                    <ComboBox x:Name="SportFilterComboBox" Width="150" Height="30" Margin="10 0 0 0"
                              DisplayMemberPath="Name" SelectionChanged="SportFilterComboBox_SelectionChanged"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Добавить выбранных" Style="{StaticResource SuccessButtonStyle}"
                        Click="AddSelectedParticipants_Click" Padding="10 5"/>
            </Grid>

            <!-- Список доступных спортсменов -->
            <DataGrid x:Name="AvailableSportsmenGrid" AutoGenerateColumns="False" 
                      Height="200" Margin="0 10 0 0" SelectionMode="Extended">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Выбрать" Binding="{Binding IsSelected}"/>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Команда" Binding="{Binding Team}" Width="150"/>
                    <DataGridTextColumn Header="Уровень" Binding="{Binding Lvl}" Width="100"/>
                    <DataGridTextColumn Header="Виды спорта" Binding="{Binding SportsText}" Width="200"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <!-- Участники турнира -->
        <StackPanel Grid.Row="3" Margin="0 20 0 0">
            <TextBlock Text="Участники турнира" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>

            <DataGrid x:Name="ParticipantsGrid" AutoGenerateColumns="False" 
                      Height="200" Margin="0 10 0 0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ФИО" Binding="{Binding PlayerName}" Width="*"/>
                    <DataGridTextColumn Header="Команда" Binding="{Binding Team}" Width="150"/>
                    <DataGridTextColumn Header="Место" Binding="{Binding Position}" Width="80">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Результат" Binding="{Binding Score}" Width="120"/>
                    <DataGridTextColumn Header="Очки" Binding="{Binding Points}" Width="80">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox">
                                <Setter Property="TextAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Удалить" Style="{StaticResource DangerButtonStyle}"
                                        Click="RemoveParticipant_Click" Tag="{Binding Id}"
                                        Padding="5 2" FontSize="10"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <!-- Кнопки управления -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 20 0 0">
            <Button Content="Отмена" Style="{StaticResource AdminButtonStyle}" 
                    Background="#95a5a6" Click="Cancel_Click" Margin="0 0 10 0" Padding="15 10"/>
            <Button Content="Сохранить" Style="{StaticResource SuccessButtonStyle}" 
                    Click="Save_Click" Padding="15 10"/>
        </StackPanel>
    </Grid>
</Window>
