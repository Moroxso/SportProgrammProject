<Window x:Class="SportProgramm.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SportProgramm"
        Icon="Resources\Logo.png"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        Title="SportPedia" Width="1920" Height="1080">

    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource AdaptiveMenuBorder}">
                <!-- Основной контейнер меню -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Лого -->
                        <ColumnDefinition Width="*"/>
                        <!-- Навигация -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Кнопки входа -->
                    </Grid.ColumnDefinitions>

                    <!-- Логотип -->
                    <Image Grid.Column="0" Source="Resources\Logo.png" Style="{StaticResource AdaptiveLogo}"/>

                    <!-- Навигационные кнопки (центр) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Style="{StaticResource AdaptiveMenuButton}" Content="Домашняя" Click="ButtonHome"/>
                        <Button Style="{StaticResource AdaptiveMenuButton}" Content="Турниры" Click="ButtonTournaments"/>
                        <Button Style="{StaticResource AdaptiveMenuButton}" Content="Топ Спортсменов" Click="ButtonTop"/>
                    </StackPanel>

                    <!-- Кнопки авторизации (справа) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10 0">
                        <!-- Информация о пользователе -->
                        <TextBlock x:Name="UserInfoText" 
                                   Text="Гость" 
                                   VerticalAlignment="Center" 
                                   Margin="0 0 10 0" 
                                   Foreground="#2c3e50" 
                                   FontWeight="SemiBold"
                                   Visibility="Collapsed"/>

                        <!-- Кнопка админ-панели (только для админов) -->
                        <Button x:Name="AdminButton" 
                                Content="Админ-панель" 
                                Style="{StaticResource AdaptiveMenuButton}"
                                Click="ButtonAdmin_Click"
                                Visibility="Collapsed"
                                Margin="0 0 10 0"/>

                        <!-- Кнопки для неавторизованных пользователей -->
                        <Button x:Name="LoginButton" 
                                Content="Войти" 
                                Style="{StaticResource AdaptiveMenuButton}"
                                Click="ButtonLogin_Click"/>
                        <Button x:Name="RegisterButton" 
                                Content="Регистрация" 
                                Style="{StaticResource AdaptiveMenuButton}"
                                Click="ButtonRegistrator_Click" 
                                Margin="5 0 0 0"/>

                        <!-- Кнопка выхода для авторизованных пользователей -->
                        <Button x:Name="LogoutButton" 
                                Content="Выйти" 
                                Style="{StaticResource AdaptiveMenuButton}"
                                Click="ButtonLogout_Click" 
                                Margin="5 0 0 0"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Контентная область -->
        <Frame x:Name="FrmMain" Height="Auto" NavigationUIVisibility="Hidden"/>
    </StackPanel>

</Window>
